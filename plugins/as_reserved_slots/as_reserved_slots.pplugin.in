{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${AS_RESERVED_SLOTS_VERSION}",
	"name": "as_reserved_slots",
	"description": "Keeps a number of server slots ('public_slots' in reserved_slots.ini) free for players carrying the reserve permission/flag: a non-reserve player authorizing while the server holds more than public_slots non-reserve players is disconnected, and a reserve player takes the slot of the first non-reserve player. Ported from the Pisex admin_system module 'Reserved_slots' ([AS] Reserved slots by ABKAM), keeping the config keys, the permission/flag check and the kick reason. Requires the admin_system core.",
	"author": "ABKAM, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/as_reserved_slots",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
